# =======================================================
# Weibo Bot Shield Project .gitignore
# =======================================================

# 1. 核心数据与日志 (安全与隐私)
topic_cache.db
*.log
weibo_bot.log

# 2. 爬虫数据输出目录
weibo-search/结果文件/
*.csv
# 保留测试和打标用的金库数据集（如果你想传的话）
!golden_testset_labeled.csv
!golden_testset_15features.csv

# 3. 配置文件
# settings.py 已清理敏感信息（Cookie 为空），可以安全提交
# 用户通过前端注入自己的 Cookie，不再依赖 settings.py 中的 Cookie

# 4. 模型文件 (体积太大，通常不传，视情况可单独强制上传 *.pkl)
*.pkl

# 5. Python 环境与缓存
__pycache__/
*.py[cod]
*$py.class
venv/
venv_weibo/
.env

# 6. IDE 与系统隐藏文件
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
.gemini/

topic_cache.db
weibo_bot.log
